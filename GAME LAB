<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#00ff9d">
  <meta name="description" content="GAME LAB - HTML Game Playground by AzAppuz">
  <link rel="manifest" href="manifest.json">
  <link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/686/686589.png">
  <title>GAME LAB</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', system-ui, sans-serif;
    }
    body {
      background: #0a0a12;
      color: #e0e0e0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }
    .bg {
      position: fixed;
      inset: 0;
      z-index: -1;
      background: 
        radial-gradient(ellipse at 20% 20%, rgba(0, 255, 157, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(0, 180, 255, 0.07) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 50%, rgba(120, 0, 255, 0.05) 0%, transparent 60%),
        linear-gradient(135deg, #0a0a12 0%, #0f0f1a 50%, #0a0a12 100%);
      animation: bgPulse 12s ease-in-out infinite alternate;
    }
    .bg::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        radial-gradient(1px 1px at 20px 30px, rgba(0, 255, 157, 0.4), transparent),
        radial-gradient(1px 1px at 40px 70px, rgba(0, 200, 255, 0.3), transparent),
        radial-gradient(1px 1px at 90px 40px, rgba(180, 0, 255, 0.3), transparent),
        radial-gradient(1px 1px at 130px 80px, rgba(0, 255, 157, 0.25), transparent),
        radial-gradient(1.5px 1.5px at 160px 30px, rgba(0, 200, 255, 0.2), transparent);
      background-size: 200px 100px;
      animation: stars 40s linear infinite;
      opacity: 0.6;
    }
    @keyframes bgPulse {
      0% { filter: hue-rotate(0deg); }
      100% { filter: hue-rotate(25deg); }
    }
    @keyframes stars {
      from { transform: translateY(0); }
      to { transform: translateY(-100px); }
    }
    header {
      background: rgba(15, 15, 25, 0.85);
      backdrop-filter: blur(12px);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(0, 255, 157, 0.3);
      box-shadow: 0 4px 30px rgba(0, 255, 157, 0.1);
      z-index: 10;
    }
    .logo {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      background: linear-gradient(90deg, #00ff9d, #00d4ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .logo span {
      font-size: 0.75rem;
      font-weight: 500;
      color: #aaa;
      -webkit-text-fill-color: #aaa;
    }
    .dev-name {
      font-size: 0.7rem;
      color: #00ff9d;
      opacity: 0.8;
      margin-left: 6px;
      font-weight: 600;
    }
    .toolbar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    button {
      background: #00ff9d;
      color: #0a0a12;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-size: 0.85rem;
    }
    button:hover {
      background: #00d4ff;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(0, 212, 255, 0.3);
    }
    button.secondary {
      background: transparent;
      color: #00ff9d;
      border: 1px solid #00ff9d;
    }
    button.secondary:hover {
      background: #00ff9d;
      color: #0a0a12;
    }
    select {
      background: #1a1a2a;
      color: #00ff9d;
      border: 1px solid #00ff9d;
      padding: 7px 10px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      font-size: 0.85rem;
    }
    .main {
      flex: 1;
      display: flex;
      overflow: hidden;
    }
    .editor-panel, .preview-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      border-right: 1px solid rgba(255, 255, 255, 0.05);
      background: rgba(10, 10, 18, 0.6);
    }
    .preview-panel {
      border-right: none;
    }
    .panel-header {
      background: rgba(20, 20, 35, 0.8);
      padding: 10px 16px;
      font-size: 0.8rem;
      font-weight: 600;
      color: #00ff9d;
      border-bottom: 1px solid rgba(0, 255, 157, 0.15);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    textarea {
      flex: 1;
      background: transparent;
      color: #e0e0e0;
      border: none;
      padding: 16px;
      font-family: 'Consolas', 'Courier New', monospace;
      font-size: 14px;
      line-height: 1.5;
      resize: none;
      outline: none;
    }
    iframe {
      flex: 1;
      width: 100%;
      border: none;
      background: #111;
    }
    footer {
      text-align: center;
      padding: 6px;
      font-size: 0.7rem;
      color: #666;
      background: rgba(10, 10, 18, 0.9);
      border-top: 1px solid rgba(0, 255, 157, 0.1);
    }
    footer span {
      color: #00ff9d;
      font-weight: 600;
    }
    @media (max-width: 768px) {
      .main {
        flex-direction: column;
      }
      .editor-panel, .preview-panel {
        height: 50%;
      }
      header {
        flex-direction: column;
        gap: 10px;
        padding: 12px;
      }
    }
  </style>
</head>
<body>
  <div class="bg"></div>

  <header>
    <div class="logo">
      GAME LAB
      <span>HTML Game Playground</span>
      <span class="dev-name">by AzAppuz</span>
    </div>
    <div class="toolbar">
      <select id="exampleSelect" onchange="loadExample()">
        <option value="">Load Example Game...</option>
        <option value="clicker">1. Clicker Game</option>
        <option value="catch">2. Catch the Ball</option>
        <option value="snake">3. Mini Snake</option>
      </select>
      <button onclick="runCode()">▶ Run Game</button>
      <button class="secondary" onclick="clearCode()">Clear</button>
    </div>
  </header>

  <div class="main">
    <div class="editor-panel">
      <div class="panel-header">
        <span>HTML / CSS / JS Code</span>
        <span style="font-size:0.7rem; opacity:0.6;">Write your game here</span>
      </div>
      <textarea id="codeEditor" spellcheck="false" placeholder="Paste or write your HTML game code here..."></textarea>
    </div>

    <div class="preview-panel">
      <div class="panel-header">
        <span>Live Game Preview</span>
        <button class="secondary" style="padding:4px 10px; font-size:0.75rem;" onclick="toggleFullscreen()">Fullscreen</button>
      </div>
      <iframe id="preview" sandbox="allow-scripts allow-same-origin"></iframe>
    </div>
  </div>

  <footer>
    GAME LAB • Developed by <span>AzAppuz</span>
  </footer>

  <script>
    // Register Service Worker for PWA
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('./sw.js')
        .then(() => console.log('Service Worker Registered'))
        .catch(err => console.log('SW registration failed:', err));
    }

    const starterCode = `<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      margin: 0; height: 100vh;
      display: flex; justify-content: center; align-items: center;
      background: #0f0f1a; color: white; font-family: sans-serif;
      flex-direction: column; gap: 20px;
    }
    h1 { color: #00ff9d; }
    button {
      padding: 15px 30px; font-size: 1.2rem;
      background: #00ff9d; border: none; border-radius: 8px;
      cursor: pointer; font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>Welcome to GAME LAB</h1>
  <p>Edit the code on the left and click "Run Game"</p>
  <button onclick="alert('You made a game!')">Click Me!</button>
</body>
</html>`;

    const examples = {
      clicker: `<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      margin: 0; height: 100vh;
      display: flex; flex-direction: column;
      justify-content: center; align-items: center;
      background: linear-gradient(135deg, #0f0c29, #302b63);
      color: white; font-family: sans-serif;
    }
    h1 { color: #00ff9d; margin-bottom: 10px; }
    #score { font-size: 3rem; margin: 20px 0; }
    button {
      padding: 20px 40px; font-size: 1.5rem;
      background: #00ff9d; border: none;
      border-radius: 12px; cursor: pointer;
      font-weight: bold; transition: transform 0.1s;
    }
    button:active { transform: scale(0.95); }
  </style>
</head>
<body>
  <h1>CLICKER GAME</h1>
  <div id="score">0</div>
  <button onclick="clickMe()">CLICK!</button>
  <script>
    let score = 0;
    function clickMe() {
      score++;
      document.getElementById('score').innerText = score;
    }
  <\/script>
</body>
</html>`,

      catch: `<!DOCTYPE html>
<html>
<head>
  <style>
    body { margin: 0; overflow: hidden; background: #0f0f13; }
    canvas { display: block; }
  </style>
</head>
<body>
  <canvas id="c"></canvas>
  <script>
    const canvas = document.getElementById('c');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    let score = 0;
    let basket = { x: canvas.width/2 - 40, y: canvas.height - 40, w: 80, h: 20 };
    let ball = { x: Math.random()*canvas.width, y: 0, r: 15, speed: 4 };
    function draw() {
      ctx.fillStyle = '#0f0f13';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00ff9d';
      ctx.fillRect(basket.x, basket.y, basket.w, basket.h);
      ctx.beginPath();
      ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI*2);
      ctx.fillStyle = '#ff6b6b';
      ctx.fill();
      ctx.fillStyle = 'white';
      ctx.font = '24px sans-serif';
      ctx.fillText('Score: ' + score, 20, 40);
      ball.y += ball.speed;
      if (ball.y + ball.r > basket.y && ball.x > basket.x && ball.x < basket.x + basket.w) {
        score++;
        ball.y = 0;
        ball.x = Math.random() * canvas.width;
        ball.speed += 0.2;
      }
      if (ball.y > canvas.height) {
        ball.y = 0;
        ball.x = Math.random() * canvas.width;
      }
      requestAnimationFrame(draw);
    }
    window.addEventListener('mousemove', e => {
      basket.x = e.clientX - basket.w/2;
    });
    draw();
  <\/script>
</body>
</html>`,

      snake: `<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      margin: 0; height: 100vh;
      display: flex; justify-content: center; align-items: center;
      background: #0f0f13; flex-direction: column; color: white;
      font-family: sans-serif;
    }
    canvas { border: 3px solid #00ff9d; background: #1a1a2e; }
    h2 { color: #00ff9d; margin-bottom: 10px; }
  </style>
</head>
<body>
  <h2>MINI SNAKE</h2>
  <p>Use Arrow Keys</p>
  <canvas id="game" width="400" height="400"></canvas>
  <script>
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const grid = 20;
    let snake = [{x: 10, y: 10}];
    let food = {x: 15, y: 15};
    let dx = 1, dy = 0;
    let score = 0;
    function draw() {
      ctx.fillStyle = '#1a1a2e';
      ctx.fillRect(0, 0, 400, 400);
      ctx.fillStyle = '#00ff9d';
      snake.forEach(s => ctx.fillRect(s.x*grid, s.y*grid, grid-2, grid-2));
      ctx.fillStyle = '#ff6b6b';
      ctx.fillRect(food.x*grid, food.y*grid, grid-2, grid-2);
      const head = {x: snake[0].x + dx, y: snake[0].y + dy};
      snake.unshift(head);
      if (head.x === food.x && head.y === food.y) {
        score++;
        food = {x: Math.floor(Math.random()*20), y: Math.floor(Math.random()*20)};
      } else {
        snake.pop();
      }
      if (head.x < 0 || head.x >= 20 || head.y < 0 || head.y >= 20) {
        snake = [{x:10,y:10}]; dx=1; dy=0; score=0;
      }
    }
    document.addEventListener('keydown', e => {
      if (e.key === 'ArrowUp' && dy !== 1) { dx=0; dy=-1; }
      if (e.key === 'ArrowDown' && dy !== -1) { dx=0; dy=1; }
      if (e.key === 'ArrowLeft' && dx !== 1) { dx=-1; dy=0; }
      if (e.key === 'ArrowRight' && dx !== -1) { dx=1; dy=0; }
    });
    setInterval(draw, 120);
  <\/script>
</body>
</html>`
    };

    document.getElementById('codeEditor').value = starterCode;
    runCode();

    function runCode() {
      const code = document.getElementById('codeEditor').value;
      document.getElementById('preview').srcdoc = code;
    }

    function clearCode() {
      document.getElementById('codeEditor').value = '';
      document.getElementById('preview').srcdoc = '';
    }

    function loadExample() {
      const value = document.getElementById('exampleSelect').value;
      if (value && examples[value]) {
        document.getElementById('codeEditor').value = examples[value];
        runCode();
      }
    }

    function toggleFullscreen() {
      const iframe = document.getElementById('preview');
      if (iframe.requestFullscreen) iframe.requestFullscreen();
    }

    let timeout;
    document.getElementById('codeEditor').addEventListener('input', () => {
      clearTimeout(timeout);
      timeout = setTimeout(runCode, 800);
    });
  </script>
</body>
</html>
